{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "predicates"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[FPU][0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "predicates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "profile"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"},
          "type": {"const": "lab_semantics"},
          "profile": {
            "enum": [
              "remote_doctor", "orientation", "task_transition", "tdd_history",
              "approved_spec_plan", "pr_receipt", "accepted_adr", "dependency_review",
              "checkpoint_remediation", "provenance_recovery", "stride_model",
              "hygiene_snapshot", "sprint_decisions", "audit_guard_observation",
              "refactor_chore_release", "initialized_fixture", "initialized_projects", "debug_spike_conflict",
              "preview_evidence", "u06_preview_evidence", "capstone"
            ]
          },
          "artifact": {"$ref": "#/$defs/path"},
          "candidate": {"$ref": "#/$defs/path"},
          "context": {"$ref": "#/$defs/path"},
          "board": {"$ref": "#/$defs/path"},
          "audit": {"$ref": "#/$defs/path"},
          "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"},
          "code": {"$ref": "#/$defs/path"},
          "test": {"$ref": "#/$defs/path"},
          "spec": {"$ref": "#/$defs/path"},
          "plan": {"$ref": "#/$defs/path"},
          "brief": {"$ref": "#/$defs/path"},
          "deliverable": {"$ref": "#/$defs/path"},
          "observation": {"$ref": "#/$defs/path"},
          "receipt": {"$ref": "#/$defs/path"},
          "adr": {"$ref": "#/$defs/path"},
          "decision_log": {"$ref": "#/$defs/path"},
          "review": {"$ref": "#/$defs/path"},
          "project": {"$ref": "#/$defs/path"},
          "report": {"$ref": "#/$defs/path"},
          "handoff": {"$ref": "#/$defs/path"},
          "source": {"$ref": "#/$defs/path"},
          "preserved_path": {"$ref": "#/$defs/path"},
          "provenance": {"$ref": "#/$defs/path"},
          "model": {"$ref": "#/$defs/path"},
          "target": {"$ref": "#/$defs/path"},
          "target_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "snapshot": {"$ref": "#/$defs/path"},
          "sprint_log": {"$ref": "#/$defs/path"},
          "overrides": {"$ref": "#/$defs/path"},
          "metrics": {"$ref": "#/$defs/path"},
          "chore": {"$ref": "#/$defs/path"},
          "tag_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,31}$"},
          "scenario": {"$ref": "#/$defs/path"},
          "release_target": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "release_tag": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "release_changelog": {"$ref": "#/$defs/path"},
          "release_targets": {"$ref": "#/$defs/path"},
          "workspace": {"$ref": "#/$defs/path"},
          "greenfield": {"$ref": "#/$defs/path"},
          "brownfield": {"$ref": "#/$defs/path"},
          "debug": {"$ref": "#/$defs/path"},
          "spike": {"$ref": "#/$defs/path"},
          "conflict": {"$ref": "#/$defs/path"},
          "pr_receipt": {"$ref": "#/$defs/path"},
          "submission_boundary": {"$ref": "#/$defs/path"},
          "spec_directory": {"$ref": "#/$defs/path"},
          "plan_directory": {"$ref": "#/$defs/path"},
          "adr_directory": {"$ref": "#/$defs/path"},
          "audit_directory": {"$ref": "#/$defs/path"}
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*:)[^/]+(?:/[^/]+)*$"
    }
  }
}
