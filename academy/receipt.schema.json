{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_commit", "catalog_sha256", "checkpoints",
    "capstone_commit_range", "host_labels", "completion_date", "trust_model"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "source_commit": {"$ref": "#/$defs/git"},
    "catalog_sha256": {"$ref": "#/$defs/sha"},
    "checkpoints": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "attempt", "attempt_head", "prepared_commit", "base_commit", "catalog_sha256",
          "definition_sha256", "manifest_sha256", "source_sha256",
          "contract_sha256", "result_sha256"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[FPU][0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "attempt": {"type": "string", "pattern": "^academy/[FPU][0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*/[1-9][0-9]*$"},
          "attempt_head": {"$ref": "#/$defs/git"},
          "prepared_commit": {"$ref": "#/$defs/git"},
          "base_commit": {"$ref": "#/$defs/git"},
          "catalog_sha256": {"$ref": "#/$defs/sha"},
          "definition_sha256": {"$ref": "#/$defs/sha"},
          "manifest_sha256": {"$ref": "#/$defs/sha"},
          "source_sha256": {"$ref": "#/$defs/sha"},
          "contract_sha256": {"$ref": "#/$defs/sha"},
          "result_sha256": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "capstone_commit_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/git"}, "to": {"$ref": "#/$defs/git"}}
    },
    "host_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"const": "local-git"}
    },
    "completion_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "trust_model": {"const": "installed-local-verifier"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
