{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbiterforge.github.io/arbiter-academy/schema/lesson-action-v1.json",
  "title": "Arbiter Academy lesson action manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_contract_version", "document_id", "actions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "lesson_contract_version": {"type": "integer", "const": 1},
    "document_id": {"$ref": "#/$defs/id"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,95}$"
    },
    "prose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "nullableProse": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/prose"}
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://github\\.com/arbiterForge/arbiter-academy(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~!$&'()*+,;=:@-]+)*$"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "operating_system", "host", "language", "command", "copy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "surface": {"enum": ["browser", "native-terminal", "harness", "academy-console"]},
        "operating_system": {"enum": ["all", "windows", "macos", "linux"]},
        "host": {"enum": ["none", "claude-code", "codex", "pi"]},
        "language": {"enum": ["none", "powershell", "sh", "text", "codearbiter"]},
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0009\\u000B-\\u001F\\u007F]+$"
        },
        "copy": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "sequence", "title", "actor", "surface", "instruction",
        "rationale", "resources", "variants", "expected_result", "recovery", "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 64},
        "title": {"$ref": "#/$defs/prose"},
        "actor": {"enum": ["learner", "academy", "agent"]},
        "surface": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["browser", "native-terminal", "harness", "academy-console"]}
          ]
        },
        "instruction": {"$ref": "#/$defs/prose"},
        "rationale": {"$ref": "#/$defs/nullableProse"},
        "resources": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/resource"}
        },
        "variants": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/variant"}
        },
        "expected_result": {"$ref": "#/$defs/prose"},
        "recovery": {"$ref": "#/$defs/prose"},
        "evidence": {"$ref": "#/$defs/nullableProse"}
      },
      "oneOf": [
        {
          "properties": {
            "surface": {"enum": ["browser", "native-terminal", "academy-console"]},
            "variants": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "surface": {"type": "null"},
            "variants": {"minItems": 1, "maxItems": 12}
          }
        }
      ]
    }
  }
}
