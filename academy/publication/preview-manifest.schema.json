{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arbiter Academy Preview 0.11 publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "lesson_contract_version", "available_labs", "runnable_labs", "guided_labs", "coming_next", "prerequisites", "known_limits", "discussion_url", "catalog_sha256"],
  "properties": {
    "release": {"const": "preview-0.11"},
    "lesson_contract_version": {"type": "integer", "const": 1},
    "available_labs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": false,
      "prefixItems": [
        {"const": "F01-fork-clone-doctor"},
        {"const": "F02-orient-to-state"},
        {"const": "F03-work-the-board"},
        {"const": "F04-fix-with-evidence"},
        {"const": "P01-feature-through-plan"},
        {"const": "P02-commit-review-pr"},
        {"const": "P03-record-an-adr"},
        {"const": "P04-review-a-dependency"},
        {"const": "P05-checkpoint-remediation"}
      ]
    },
    "runnable_labs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": false,
      "prefixItems": [
        {"const": "F01-fork-clone-doctor"},
        {"const": "F02-orient-to-state"},
        {"const": "F03-work-the-board"},
        {"const": "F04-fix-with-evidence"},
        {"const": "P01-feature-through-plan"},
        {"const": "P02-commit-review-pr"},
        {"const": "P03-record-an-adr"},
        {"const": "P04-review-a-dependency"},
        {"const": "P05-checkpoint-remediation"}
      ]
    },
    "guided_labs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": false,
      "prefixItems": [
        {"const": "F01-fork-clone-doctor"},
        {"const": "F02-orient-to-state"},
        {"const": "F03-work-the-board"},
        {"const": "F04-fix-with-evidence"},
        {"const": "P01-feature-through-plan"},
        {"const": "P02-commit-review-pr"},
        {"const": "P03-record-an-adr"},
        {"const": "P04-review-a-dependency"},
        {"const": "P05-checkpoint-remediation"}
      ]
    },
    "coming_next": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": false,
      "prefixItems": [
        {"const": "P06-context-drift-recovery"},
        {"const": "P07-threat-model"},
        {"const": "P08-repository-hygiene"}
      ]
    },
    "prerequisites": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": false,
      "prefixItems": [
        {"const": "A GitHub account that can create a personal fork."},
        {"const": "Git 2.39 or newer."},
        {"const": "Python 3.11 or newer."},
        {"const": "A supported CodeArbiter host: Claude Code, Codex, or Pi."},
        {"const": "Complete Academy Home setup steps 1-5 before starting F01."}
      ]
    },
    "known_limits": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": false,
      "prefixItems": [
        {"const": "F01-F04 and P01-P05 are the guided lessons published in Preview 0.11."},
        {"const": "P06-P08 are coming next after their guided rewrites are accepted."},
        {"const": "The Power User track is not published in Preview 0.11."},
        {"const": "Graduation is unavailable until the complete 19-lab course is published."}
      ]
    },
    "discussion_url": {
      "type": "string",
      "pattern": "^https://github\\.com/arbiterForge/arbiter-academy/discussions(?:/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)*/?$"
    },
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
